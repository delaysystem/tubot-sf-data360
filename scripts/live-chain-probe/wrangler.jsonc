{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tubot-live-chain-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true,
    // Billing: automatic invocation logs + traces bill per persisted event
    // (Oct 2026: ~21M events ≈ $0.72). App console logs still persist.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "tubot-sf-auth-staging",
      "entrypoint": "TubotSfAuthEntrypoint"
    },
    {
      "binding": "DATA360",
      "service": "tubot-sf-data360",
      "entrypoint": "TubotSfData360Entrypoint"
    }
  ]
}
