{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tubot-live-chain-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "tubot-sf-auth-staging",
      "entrypoint": "TubotSfAuthEntrypoint"
    },
    {
      "binding": "DATA360",
      "service": "tubot-sf-data360",
      "entrypoint": "TubotSfData360Entrypoint"
    }
  ]
}
