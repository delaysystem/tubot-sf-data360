{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tubot-sf-data360",
  "account_id": "3b27bbae23636a0e40eff144e12d7317",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    // Billing: automatic invocation logs + traces bill per persisted event
    // (Oct 2026: ~21M events ≈ $0.72). App console logs still persist.
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
    "traces": { "enabled": false }
  },
  "upload_source_maps": true,
  "vars": {
    "BACKBLAZE_BUCKET_NAME": "tubot-encrypted",
    "DATA360_PATH_PREFIX": "data360"
  },
  "services": [
    {
      "binding": "TUBOT_SF_AUTH",
      "service": "tubot-sf-auth-staging",
      "entrypoint": "TubotSfAuthEntrypoint"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-dashboard-db-staging",
      "database_id": "572e8088-0bf1-415d-b907-a9fbc62b63ed"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DATA360_KV",
      "id": "2713c7702b724b9db0ae0785b5dcff10"
    }
  ],
  "env": {
    "production": {
      "name": "tubot-sf-data360-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "BACKBLAZE_BUCKET_NAME": "tubot-encrypted",
        "DATA360_PATH_PREFIX": "data360-prod"
      },
      "services": [
        {
          "binding": "TUBOT_SF_AUTH",
          "service": "tubot-sf-auth",
          "entrypoint": "TubotSfAuthEntrypoint"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-dashboard-db-production",
          "database_id": "9ffc87cf-dcd6-4e34-8537-49ca46fdbe96"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "DATA360_KV",
          "id": "e18cc852884944f1906b7169c75a54f8"
        }
      ]
    }
  }
}
